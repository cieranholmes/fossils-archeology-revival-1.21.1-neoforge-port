.gradle
**/build/
!src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# VS Code
.vscode/

# NeoForge run/test directory
run/

# macOS
.DS_Store
src/generated/

# Local-only jars for mods with no public NeoForge 1.21.1 build (e.g. Rainbow Reef's private port) -
# not redistributable, so kept out of source control; see build.gradle's Rainbow Reef compat comment.
libs/
